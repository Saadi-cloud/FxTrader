@model DashboardData
@{
    ViewData["Title"] = "Dashboard";
    // ViewData["Subtitle"] = $"Welcome back, {Model.FullName}";

    var compactUserId = string.Concat((Model.UserTraceId ?? string.Empty).Where(char.IsDigit));
    // var totalPortfolio = Model.AvailableBalance + Model.HeldBalance;
    var totalPortfolio = Model.AvailableBalance;

    var pnlClass = Model.TodayPnl > 0 ? "positive" : Model.TodayPnl < 0 ? "negative" : "neutral";
    var pnlPrefix = Model.TodayPnl > 0 ? "+" : Model.TodayPnl < 0 ? "-" : string.Empty;
    var pnlAmount = Math.Abs(Model.TodayPnl);
    var rate = Model.ReferralCommissionPercent > 0 ? Model.ReferralCommissionPercent : 5m;
    var rateText = rate.ToString("0.##");
    var TotalWithdrawals = Model.TotalWithdrawals;
    var Profit_Earned = Model.Profit_Withdrawals + Model.ProfitBalance + Model.HeldProfitBalance;
    var investmentPercent = totalPortfolio > 0 ? Math.Clamp(Model.InvestmentBalance / totalPortfolio * 100m, 0m, 100m) : 0m;
    var profitPercent = totalPortfolio > 0 ? Math.Clamp(Model.ProfitBalance / totalPortfolio * 100m, 0m, 100m) : 0m;
    var commissionPercent = totalPortfolio > 0 ? Math.Clamp(Model.CommissionBalance / totalPortfolio * 100m, 0m, 100m) : 0m;
    var ringInvestmentEnd = investmentPercent;
    var ringProfitEnd = investmentPercent + profitPercent;
    var investmentCss = investmentPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    var profitCss = profitPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    var commissionCss = commissionPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    var ringInvestmentCss = ringInvestmentEnd.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    var ringProfitCss = ringProfitEnd.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    var encodedShareUrl = Uri.EscapeDataString(Model.ReferralLink);
    var whatsappMessage = Uri.EscapeDataString($"\n\n{Model.ReferralLink}");
    var telegramMessage = Uri.EscapeDataString($"Join OLX Trade — {rateText}% Referral Commission. Referral code: {Model.UserTraceId}");


}
<style>
    .trade-uid {
        font-size: 07px;
    }

        .trade-uid span {
            font-size: 07px;
        }

        .trade-uid b {
            font-size: 8px;
        }

    .trade-portfolio-value {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .balance-eye-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        padding: 0;
        border: none;
        background: rgba(255, 255, 255, 0.06);
        border-radius: 8px;
        color: #848e9c;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
    }

        .balance-eye-btn:hover {
            background: rgba(240, 185, 11, 0.1);
            color: var(--gold, #f0b90b);
        }

        .balance-eye-btn svg {
            width: 17px;
            height: 17px;
        }

    .trade-social-grid .sp.youtube span {
        background: transparent;
    }

        .trade-social-grid .sp.youtube span svg {
            width: 26px;
            height: 26px;
            display: block;
        }

    .trade-social-grid .sp.youtube:hover {
        border-color: #ff0000;
        transform: translateY(-3px);
    }

        .trade-social-grid .sp.youtube:hover span svg rect {
            fill: #e60000;
        }

    .trade-social-grid .sp.youtube span svg {
        width: 26px;
        height: 26px;
        display: block;
        animation: yt-pulse 2.4s ease-in-out infinite;
    }

    @@keyframes yt-pulse {
        0%, 100% {
            transform: scale(1);
            filter: drop-shadow(0 0 0 rgba(255, 0, 0, 0));
        }

        50% {
            transform: scale(1.08);
            filter: drop-shadow(0 0 6px rgba(255, 0, 0, 0.55));
        }
    }

    .trade-social-grid .sp.youtube:hover span svg {
        animation: none;
        transform: scale(1.15);
        filter: drop-shadow(0 0 10px rgba(255, 0, 0, 0.7));
        transition: transform 0.2s ease, filter 0.2s ease;
    }

    .trade-social-grid .sp.youtube:hover {
        border-color: #ff0000;
        transform: translateY(-3px);
    }

    @@media (prefers-reduced-motion: reduce) {
        .trade-social-grid .sp.youtube span svg {
            animation: none;
        }
    }

    .trade-share.wa {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #fff;
    }


        .trade-share.wa i {
            color: #25D366;
            font-size: 22px;
        }

    .trade-share.fb {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #fff;
    }


        .trade-share.fb i {
            color: #1877F2;
            font-size: 22px;
        }
</style>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var display = document.getElementById('balanceDisplay');
            var toggleBtn = document.getElementById('balanceToggle');
            var eyeOpen = document.getElementById('eyeOpen');
            var eyeClosed = document.getElementById('eyeClosed');
            if (!display || !toggleBtn) {
                console.warn('Balance toggle elements not found');
                return;
            }

            var realValue = '$' + display.dataset.realValue;
            var maskedValue = '*****';
            var isHidden = localStorage.getItem('olx_balance_hidden') === 'true';

            function render() {
                display.textContent = isHidden ? maskedValue : realValue;
                eyeOpen.style.display = isHidden ? 'none' : '';
                eyeClosed.style.display = isHidden ? '' : 'none';
            }

            toggleBtn.addEventListener('click', function () {
                isHidden = !isHidden;
                localStorage.setItem('olx_balance_hidden', isHidden);
                render();
            });

            render();
        });
    </script>
}

