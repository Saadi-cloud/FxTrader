                    <button type="button" class="is-active" data-referral-tab="all" role="tab" aria-selected="true">
                        Total Referrals <em>@referralList.Count</em>
                    </button>
                    <button type="button" data-referral-tab="active" role="tab" aria-selected="false">
                        Active Referral <em>@activeReferrals.Count</em>
                    </button>
                </div>

                <div class="trade-referral-listwrap" data-referral-pane="all">
                    @if (referralList.Count == 0)
                    {
                        <p class="trade-referral-empty">No referrals yet. Share your link above to get started.</p>
