@model IReadOnlyList<LedgerEntry>

@{
    ViewData["Title"] = "Account Statement";
    ViewData["Subtitle"] = "Approved deposits, compound profit, referral commission, and completed withdrawals";

    var credits = Model.Sum(x => x.Credit);
    var debits = Model.Sum(x => x.Debit);
}

<div class="mini-stat-row statement-summary-stats">
    <div class="mini-stat">
        <div class="mini-stat-label">Total Deposit</div>
        <div class="mini-stat-value mono" style="color:var(--green);">
            $@credits.ToString("N2")
        </div>
    </div>

    <div class="mini-stat">
        <div class="mini-stat-label">Total Withdrawal</div>
        <div class="mini-stat-value mono">
            $@debits.ToString("N2")
        </div>
    </div>

    <div class="mini-stat">
        <div class="mini-stat-label">Current Balance</div>
        <div class="mini-stat-value mono">
            $@(Model.FirstOrDefault()?.BalanceAfter.ToString("N2") ?? "0.00")
        </div>
    </div>
</div>

<div class="card card-pad">
    <h4>Transaction History</h4>

    <div class="tabs-row">
        @* <button class="tab-btn active" data-target="all">
            All
        </button> *@

        <button class="tab-btn" data-target="deposit">
            Deposits
        </button>

        <button class="tab-btn" data-target="withdrawal">
            Withdrawals
        </button>

        <button class="tab-btn" data-target="profit">
            Profit
        </button>

        <button class="tab-btn" data-target="commission">
            Commission
        </button>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            No ledger entries found.
        </div>
    }
    else
    {
        <div class="statement-table-wrap">
            <table class="data-table statement-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Reference</th>
                        <th class="col-deposit">Deposit</th>
                        <th class="col-withdrawal">Withdrawal</th>
                        <th>Investment</th>
                        <th class="col-profit">Profit</th>
                        <th class="col-commission">Commission</th>
                        <th>Running Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        var type =
                        row.EntryType.Contains("Deposit", StringComparison.OrdinalIgnoreCase)
                        ? "deposit"
                        : row.EntryType.Contains("Referral", StringComparison.OrdinalIgnoreCase) ||
                        row.EntryType.Contains("Commission", StringComparison.OrdinalIgnoreCase)
                        ? "commission"
                        : row.EntryType.Contains("Profit", StringComparison.OrdinalIgnoreCase) ||
                        row.EntryType.Contains("Bonus", StringComparison.OrdinalIgnoreCase)
                        ? "profit"
                        : "withdrawal";

                        <tr data-row-type="@type">
                            <td class="mono">
                                @(row.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm"))
                            </td>

                            <td class="mono">
                                @row.ReferenceNo
                            </td>

                            <td class="mono col-deposit" style="color:var(--green);">
                                @(row.Credit > 0 ? "+$" + row.Credit.ToString("N2") : "—")
                            </td>

                            <td class="mono col-withdrawal" style="color:var(--red);">
                                @(row.Debit > 0 ? "-$" + row.Debit.ToString("N2") : "—")
                            </td>

                            <td class="mono">
                                $@row.InvestmentBalanceAfter.ToString("N2")
                            </td>

                            <td class="mono col-profit" style="color:var(--green);">
                                $@row.ProfitBalanceAfter.ToString("N2")
                            </td>

                            <td class="mono col-commission" style="color:var(--gold);">
                                $@row.CommissionBalanceAfter.ToString("N2")
                            </td>

                            <td class="mono">
                                $@row.BalanceAfter.ToString("N2")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .hidden {
        display: none !important;
    }

    /* ================================
           Transaction Tabs Mobile Fix
        ================================ */
    @@media (max-width: 576px) {
        /* Tab container */
        .tabs-row {
            display: grid !important;
            grid-template-columns: repeat(2, 1fr) !important;
            align-items: center;
            justify-items: center;
            justify-content: center;
            width: 100%;
            gap: 0 !important;
            padding: 10px !important;
            box-sizing: border-box;
            border-radius: 12px;
            overflow: hidden;
        }
            /* Individual tab buttons */
            .tabs-row .tab-btn {
                display: flex !important;
                width: 100% !important;
                height: 45px;
                justify-content: center !important;
                align-items: center !important;
                padding: 0 !important;
                margin: 0 !important;
                text-align: center !important;
                font-size: 14px;
                white-space: nowrap;
                border: none;
                box-sizing: border-box;
            }
        /* Remove old flex behavior */
        .card-head,
        .tabs-row {
            flex-direction: unset !important;
            flex-wrap: unset !important;
        }
        /* Card spacing */
        .card-head {
            width: 100%;
            padding: 0;
        }
        /* Active tab */
        .tabs-row .tab-btn.active {
            border-radius: 8px;
        }
    }
</style>

<script>
    document.querySelectorAll(".tab-btn").forEach(button => {
        button.addEventListener("click", function () {
            let target = this.dataset.target;

            document.querySelectorAll(".tab-btn").forEach(btn => btn.classList.remove("active"));
            this.classList.add("active");

            // columns
            document.querySelectorAll(".col-deposit, .col-withdrawal, .col-profit, .col-commission")
                .forEach(col => col.classList.add("hidden"));

            let visibleColumns = {
                all: ["col-deposit", "col-withdrawal", "col-profit", "col-commission"],
                deposit: ["col-deposit"],
                withdrawal: ["col-withdrawal", "col-profit", "col-commission"],
                profit: ["col-profit"],
                commission: ["col-commission"]
            };

            visibleColumns[target].forEach(column => {
                document.querySelectorAll("." + column).forEach(el => el.classList.remove("hidden"));
            });

            // rows filter
            document.querySelectorAll("tbody tr").forEach(row => {
                let type = row.dataset.rowType;

                if (target == "all") {
                    row.style.display = (type == "deposit" || type == "withdrawal") ? "" : "none";
                } else {
                    row.style.display = type == target ? "" : "none";
                }
            });
        });
    });

    // default load
    document.querySelector('[data-target="all"]').click();
</script>
