@model AdminDashboardData
@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["Subtitle"] = "System-wide users, balances, deposits, and withdrawals";
}
<div class="balance-hero">
    <div class="balance-hero-top">
        <div>
            <div class="balance-label">Total User Wallet Liability</div>
            <div class="balance-amount mono">
                $@Model.TotalWalletBalance.ToString("N2") <sup>USD</sup>
            </div>
            @*   <div class="balance-change">Available plus held user balances</div> *@
        </div>
        <div class="balance-actions">
            <a asp-controller="Deposits" asp-action="Index" class="btn btn-gold">Review Deposits</a>
            <a asp-controller="Withdrawals" asp-action="Index" class="btn btn-outline">Review Withdrawals</a>
        </div>
    </div>
    <div class="balance-sub-row">
        <div class="balance-sub-item">
            Users <strong>@Model.TotalUsers</strong>
        </div>
        <div class="balance-sub-item">
            Active users <strong>@Model.ActiveUsers</strong>
        </div>
        @* <div class="balance-sub-item">
            Deposits approved today <strong class="mono" style="color:var(--green);">$@Model.ApprovedDepositsToday.ToString("N2")</strong>
        </div>
        <div class="balance-sub-item">
            Withdrawals completed today <strong class="mono"></strong>
        </div> *@
    </div>
</div>
<div class="stat-grid insight-grid">
    <div class="stat-card">
        <div class="stat-label">Eligible Users</div>
        <div class="stat-value">@Model.EligibleUsers</div>
        <div class="stat-delta">Active, verified, deposit enabled</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Total Investment</div>
        <div class="stat-value mono">$@Model.TotalInvestment.ToString("N2")</div>
        <div class="stat-delta">Across all investment wallets</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Total Profit Earned</div>
        <div class="stat-value mono" style="color:var(--green);">$@Model.TotalProfitEarned.ToString("N2")</div>
        <div class="stat-delta">Lifetime profit credited to users</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Total Commission Earned</div>
        <div class="stat-value mono" style="color:var(--green);">$@Model.TotalCommissionEarned.ToString("N2")</div>
        <div class="stat-delta">Referral commission credited</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Total Welcome Bonus</div>
        <div class="stat-value mono" style="color:var(--green);">$@Model.TotalWelcomeBonusEarned.ToString("N2")</div>
        <div class="stat-delta">First-deposit bonuses credited</div>
    </div>
</div>
<div class="stat-grid">
    @*     <div class="stat-card">
        <div class="stat-label">Total Users</div>
