<div class="card card-pad" style="margin-top:18px;">
    <div class="card-head">
        <h3>Referrers</h3>
        <a asp-controller="Referrals" asp-action="Index" class="btn btn-outline btn-sm">Referral Program</a>
    </div>
    @if (Model.Referrers.Count == 0)
    {
        <div class="empty-state">No user has referred anyone yet.</div>
    }
    else
    {
        <div class="field-group" style="max-width:520px;">
            <label class="field-label" for="referrerSearch">Find user</label>
            <input id="referrerSearch" class="field-input" placeholder="Search by name, email, trace ID...">
        </div>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Total Referrals</th>
                        <th>Active Referrals</th>
                        <th>Commission Earned</th>
                    </tr>
                </thead>
                <tbody id="referrerRows">
                    @foreach (var row in Model.Referrers)
                    {
                        <tr data-search="@row.FullName @row.Email @row.UserTraceId">
                            <td>
                                <strong>@row.FullName</strong>
                                <br>
                                <span class="mono">@row.UserTraceId</span>
                            </td>
                            <td>@row.TotalReferrals</td>
                            <td>
                                <span class="badge @(row.ActiveReferrals > 0 ? "badge-success" : "badge-pending")">@row.ActiveReferrals</span>
                            </td>
                            <td class="mono" style="color:var(--green);">$@row.CommissionEarned.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
@section Scripts {
    <script>
        document.getElementById('referrerSearch')?.addEventListener('input', function () {
            const q = this.value.trim().toLowerCase();
            document.querySelectorAll('#referrerRows tr').forEach(row => {
                row.style.display = !q || row.dataset.search.toLowerCase().includes(q) ? '' : 'none';
            });
        });
    </script>
}
