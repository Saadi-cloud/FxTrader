    <div class="stat-card">
        <div class="stat-label">Deposits approved today</div>
        <div class="stat-value">$@Model.ApprovedDepositsToday.ToString("N2")</div>
        <div class="stat-delta" style="color:var(--gold);">@* Requires manual payment *@</div>
    </div>
</div>
